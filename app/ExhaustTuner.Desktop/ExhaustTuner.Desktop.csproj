<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExhaustTuner</AssemblyName>
    <RootNamespace>ExhaustTuner.Desktop</RootNamespace>
    <Product>Exhaust Tuner</Product>
    <Company>Arcindweld</Company>
    <ApplicationIcon>exhaust.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExhaustTuner.Core\ExhaustTuner.Core.csproj" />
  </ItemGroup>
</Project>
