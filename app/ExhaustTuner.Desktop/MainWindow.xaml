<Window x:Class="ExhaustTuner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Exhaust Tuner" Width="1400" Height="950" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="exhaust.ico">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open the runs folder" Click="OpenRuns_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Fusion">
                <MenuItem Header="Install or update the Fusion add-in" Click="InstallAddIn_Click"/>
                <MenuItem Header="Add-in status" Click="AddInStatus_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Reload" Click="Reload_Click" InputGestureText="F5"/>
                <MenuItem Header="Developer tools" Click="DevTools_Click" InputGestureText="F12"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Engines and licences" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="Status" Text="Starting…"/></StatusBarItem>
        </StatusBar>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
