<Project>
  <PropertyGroup>
    <!-- The program's version. Builds on a PC are 0.1.0, the lowest of the 0.1 line, so a development copy is always
         offered the newest release. CI stamps every build with APP_VERSION (0.1.<run number>, windows.yml), and
         HostDispatcher.Version reads it back from the assembly. -->
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
